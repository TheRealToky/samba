# Copy to .env to override defaults. All keys are optional (sane dev defaults exist).
SAMBA_SECRET_KEY=dev-secret-change-me-in-production-0123456789
SAMBA_DATABASE_URL=sqlite:///./samba.db
SAMBA_ACCESS_TOKEN_EXPIRE_MINUTES=720
# Detection rule: flag a region if NDVI drops >= this % within the window below.
SAMBA_NDVI_DROP_THRESHOLD_PCT=25
SAMBA_DETECTION_WINDOW_DAYS=60
SAMBA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
