# ---------------------------------------------------------------------------
# SAMBA environment configuration (copy to .env and adjust for your machine)
# ---------------------------------------------------------------------------

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=samba
POSTGRES_PASSWORD=samba_dev_password
POSTGRES_DB=samba
# DATABASE_URL is what the API/worker use. Host `postgis` = the compose service name.
DATABASE_URL=postgresql+psycopg://samba:samba_dev_password@postgis:5432/samba

# --- Auth / security (NFR-1) ---
# Generate a strong secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-change-me-please-generate-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Redis / message queue ---
REDIS_URL=redis://redis:6379/0

# --- MinIO / object storage (S3-compatible) ---
MINIO_ROOT_USER=samba
MINIO_ROOT_PASSWORD=samba_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=samba

# --- ML inference server ---
INFERENCE_URL=http://inference:9000

# --- External data providers (Phase 2 — not required for Phase 1) ---
# Ingestion source per dataset. INGESTION_MODE is the global default; the three
# per-source overrides win when set. "sample" = deterministic synthetic data (no
# network/creds); "live" = real APIs.
#
# GBIF / iNaturalist / NASA POWER need NO API keys, so you can run those live
# while satellite stays on sample until Earth Engine credentials are set up:
#   INGESTION_MODE=sample
#   INGESTION_MODE_CLIMATE=live
#   INGESTION_MODE_BIODIVERSITY=live
INGESTION_MODE=sample
INGESTION_MODE_SATELLITE=
INGESTION_MODE_CLIMATE=
INGESTION_MODE_BIODIVERSITY=
# Max occurrences pulled per region per run (live biodiversity ingestion).
BIODIVERSITY_MAX_RECORDS=500
# How far back iNaturalist is pulled within the ingestion window (days). Widen to
# broaden community/photo coverage; 0 pulls the full window (more GBIF overlap).
BIODIVERSITY_INAT_RECENT_DAYS=365
# IUCN Red List enrichment: after a full live ingestion, fill species'
# conservation status via GBIF's IUCN category endpoint (auth-free). false skips it.
IUCN_ENRICHMENT_ENABLED=true

# Google Earth Engine (live satellite only): path (inside the container) to a
# service-account JSON key, and the GCP project registered for Earth Engine.
# Wire the key in with the docker-compose.gee.yml overlay (see that file).
GEE_SERVICE_ACCOUNT_JSON=/run/secrets/gee-service-account.json
GEE_PROJECT=

# ---------------------------------------------------------------------------
# Two-server deployment (see infra/deploy/two-server-runbook.md)
# ---------------------------------------------------------------------------
# Host port for the dashboard container. Bound to loopback; the host nginx
# proxies to it. 8080 and 8000 are taken by the pre-existing apps on those boxes.
SAMBA_WEB_PORT=8090

# web-01 ONLY: private IP to publish PostGIS/Redis/MinIO on. Never 0.0.0.0 —
# Redis has no auth and Postgres/MinIO would be internet-reachable.
DATA_BIND_IP=10.0.0.11

# web-02 ONLY: point the app at web-01's data tier instead of local containers,
# and leave migrations to web-01.
#   DATABASE_URL=postgresql+psycopg://samba:<password>@10.0.0.11:5432/samba
#   REDIS_URL=redis://10.0.0.11:6379/0
#   MINIO_ENDPOINT=10.0.0.11:9000
#   RUN_MIGRATIONS=false   (also set by docker-compose.apponly.yml)
