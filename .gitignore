# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
*.env
!.env.example
secrets/
*.key
*.pem
gee-service-account.json

# Node / frontend
node_modules/
web/dist/
web/.vite/

# Data / artifacts
data/
# ...except the region boundaries. `data/` matches at any depth and was silently
# swallowing this, so clones (and therefore Docker builds) shipped without it and
# alembic revision 0002_regions died at import with FileNotFoundError. It is a
# build artifact of scripts/build_regions_geojson.py, but built offline — commit
# it so image builds don't depend on fetching boundary data.
# The directory must be re-included first: git will not descend into an excluded
# directory, so a negation on the file alone has no effect.
!api/app/geo/data/
!api/app/geo/data/*.geojson
*.tif
*.tiff
*.geotiff
models/*.pt
models/*.pkl
!models/.gitkeep

# OS / editor
.idea/
.vscode/
.DS_Store
Thumbs.db

# Tooling
.claude
